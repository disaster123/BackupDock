# BackupDock has no built-in assumptions about where Docker data lives.
# Bind mounts and Docker volumes are discovered from the Docker daemon.
#
# Local mode:
#   This file lives on the Docker host and is used by `backupdock backup`.
#   Top-level backup.host_paths/exclude_*/ignore_containers and projects apply
#   to this local host.
#
# Remote mode:
#   This file lives only on the backup/controller server. BackupDock generates
#   a source-only configuration for each remote run and transfers it through
#   the SSH session. A /etc/backupdock/config.yaml on the source host is ignored
#   for remote backups and triggers a warning.

restic:
  # Local mode can use these values or the standard RESTIC_REPOSITORY and
  # RESTIC_PASSWORD_FILE environment variables.
  #
  # Remote mode does not forward repository/password_file to the source host.
  # The tunnel repository URL is generated for the session, and the repository
  # password comes from remotes.<name>.password_file on the controller.
  # repository: "sftp:backup@example:/backups/docker-host"
  # password_file: "/root/.config/restic/password"

  # Optional arguments passed only to `restic backup`. These are shared defaults
  # for local and remote backup runs.
  backup_args: []

backup:
  # Shared BackupDock behavior for local and remote source hosts.
  state_dir: "/var/lib/backupdock"
  include_compose_metadata: true

  # Local-mode source settings. Remote hosts use the corresponding fields below
  # remotes.<name> instead.
  host_paths: []
  exclude_paths: []
  exclude_volumes: []

  # Exact Docker container names that BackupDock must never stop or back up.
  # Use only for explicitly accepted exceptions such as safe one-shot --rm
  # containers. Writable overlap with selected backup data still aborts.
  ignore_containers: []

# Local-mode project-specific source settings. These apply only when running
# `backupdock backup` on this host. Remote hosts have their own projects mapping
# below remotes.<name>.projects.
projects: {}
# projects:
#   my-compose-project:
#     extra_paths: []
#     exclude_paths: []
#     exclude_volumes:
#       - "my-compose-project_large-backups"

# Optional controller-side configuration. Each remote contains its own
# source-specific host paths, exclusions, ignored containers, and project rules.
# This allows one controller to manage multiple Docker source hosts without
# mixing their rules.
remotes: {}
# remotes:
#   docker-prod:
#     ssh_target: "root@docker-prod.example"
#     password_file: "/root/.config/restic/docker-prod.password"
#     repository_path: "docker-prod"
#     rest_server_username: "docker-prod"
#     rest_server_password_file: "/root/.config/restic/docker-prod.rest-server-password"
#     local_rest_server_host: "127.0.0.1"
#     local_rest_server_port: 8000
#     remote_tunnel_port: 18080
#
#     # Source-specific settings for this Docker host.
#     host_paths: []
#     exclude_paths: []
#     exclude_volumes: []
#     ignore_containers: []
#     projects:
#       my-compose-project:
#         extra_paths: []
#         exclude_paths: []
#         exclude_volumes:
#           - "my-compose-project_large-backups"
#
#     source_command:
#       - "backupdock"
#     ssh_options: []
#     # Example when a dedicated SSH key is used:
#     # ssh_options:
#     #   - "-i"
#     #   - "/root/.ssh/backupdock"
#     # Example when BackupDock must run through sudo on the source host:
#     # source_command:
#     #   - "sudo"
#     #   - "backupdock"

# Retention belongs to the machine that has maintenance access to the
# repository. Remote source backups always force after_backup/prune off because
# the source reaches the repository only through an append-only endpoint.
retention:
  after_backup: false
  prune: false
  keep_daily: 14
  keep_weekly: 8
  keep_monthly: 12
